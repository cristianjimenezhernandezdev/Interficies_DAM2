<Window x:Class="NotifyChange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotifyChange"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Label Content="Nom"></Label>
        <TextBox Width="100" Height="30 " Text="{Binding Path=Nom, Mode=TwoWay}"></TextBox>
        <Label Content="Cognom"></Label>
        <TextBox Width="100" Height="30 " Text="{Binding Path=Cognom, Mode=TwoWay}"></TextBox>
        <Label Content="Nom Complet"></Label>
        <TextBox Width="100" Height="30 " Text="{Binding Path=NomComplet, Mode=TwoWay}"></TextBox>
    </StackPanel>
</Window>
