<Window x:Class="Combo_Box.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Combo_Box"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <ComboBox Name="Poblacions">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=NomPoblacions}" FontSize="12"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="100">
            <Label FontSize="16" FontWeight="Bold">
                Països
            </Label>
            <CheckBox Name="TotesP" IsThreeState="True" Checked="TotesP_Checked_1" Unchecked="TotesP_UChecked">
                Afegir Totes                
            </CheckBox>
            <StackPanel>
                <CheckBox Name="Espanya" Checked="Idividual_Checked" Unchecked="Idividual_UChecked">Espanya</CheckBox>
                <CheckBox Name="China" Checked="Idividual_Checked" Unchecked="Idividual_UChecked">China</CheckBox>
                <CheckBox Name="UK" Checked="Idividual_Checked" Unchecked="Idividual_UChecked">UK</CheckBox>
                <CheckBox Name="Italia" Checked="Idividual_Checked" Unchecked="Idividual_UChecked">Italia</CheckBox>
                <CheckBox Name="Portugal" Checked="Idividual_Checked" Unchecked="Idividual_UChecked">Portugal</CheckBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
