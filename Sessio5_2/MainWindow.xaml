<Window x:Class="Sessio5_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sessio5_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Button x:Name="btnCanviColor" 
                Content="Canvi de Color"
                Width="200"
                Height="60"
                Background="{x:Static Brushes.LightBlue}"
                Click="btnCanviColor_Click"
                ></Button>
        <TextBlock x:Name="txtInfo" 
                   Text="Color Inicial: LightBlue"
                   Margin="0,15,0,0"
                   HorizontalAlignment="Center"
                   ></TextBlock>
    </StackPanel>
</Window>
